# Bid Manager — production environment for docker-compose.yml.  cp .env.example .env  &&  chmod 600 .env
# Nothing here has a usable default: the server refuses to start when a REQUIRED value is missing.
# (For local development without Docker use server/.env.example instead.)

# ---- public address ---------------------------------------------------------------------------------------------
# REQUIRED. The domain Caddy serves and gets a certificate for (DNS must already point to this host).
APP_DOMAIN=bids.example.gr
# REQUIRED. Public https URL of the app — used in e-mail links, invitations and password-reset links.
APP_URL=https://bids.example.gr

# ---- database (two roles — see ops/README.md «Database roles») -----------------------------------------------------
# REQUIRED. Owner of the schema: runs migrations at start, never used by the running application.
DB_OWNER_USER=bidmanager_owner
DB_OWNER_PASSWORD=            # openssl rand -hex 24
# REQUIRED. The role the application connects with (no DDL; INSERT + SELECT only on audit_log).
DB_APP_USER=bidmanager_app
DB_APP_PASSWORD=              # openssl rand -hex 24
# docker-compose.yml builds DATABASE_URL / MIGRATION_DATABASE_URL / APP_DATABASE_ROLE from the four values above.

# ---- encryption at rest -------------------------------------------------------------------------------------------
# REQUIRED. 32 random bytes as 64 hex characters:   openssl rand -hex 32
# Encrypts every uploaded file (AES-256-GCM) AND the users' 2FA secrets. Keep a copy in the company password
# manager, separately from the backups: without it the files cannot be decrypted and every user must re-enrol 2FA.
# Never change it on a system that already has data.
FILE_ENCRYPTION_KEY=

# ---- e-mail (REQUIRED in production: invitations, password resets, approvals, digest) -----------------------------
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); false for STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Use an address of a domain with SPF and DKIM set up for the SMTP provider.
SMTP_FROM="Bid Manager <no-reply@example.gr>"

# ---- behaviour -----------------------------------------------------------------------------------------------------
# Minutes of inactivity after which a session ends (spec: «λήξη session μετά από αδράνεια»). 1–1440.
SESSION_IDLE_MINUTES=30
# Number of reverse proxies in front of the app. docker-compose.yml sets 1 (Caddy). REQUIRED in production when you
# run the app without compose: 1 behind Caddy/nginx, 0 only when the app is exposed directly. A wrong value makes
# every user share one rate limit (too low) or lets clients spoof their address (too high).
# TRUST_PROXY=1
# fatal | error | warn | info | debug
LOG_LEVEL=info
# 0 = do not run migrations when the container starts (run them as an explicit step instead).
RUN_MIGRATIONS=1

# ---- monitoring (optional) -------------------------------------------------------------------------------------------
# URL that receives every unhandled error as a JSON POST (see server/src/core/errorTracking.ts). Empty = log only.
ERROR_TRACKING_DSN=
# Label attached to error events, e.g. the git commit of the build.
RELEASE=

# ---- first run only: `docker compose exec app node server/dist/db/seed.js` --------------------------------------------
SEED_ORG_NAME="Active Computer Systems"
SEED_ADMIN_EMAIL=admin@example.gr
# At least 12 characters. Leave empty to have a random password generated and printed once by the seed command.
SEED_ADMIN_PASSWORD=
