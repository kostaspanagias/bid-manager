# Copy to server/.env (loaded automatically outside of tests).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://bidmanager:bidmanager@127.0.0.1:5432/bidmanager_dev

# Public URL of the web app (used in e-mail links and invitation URLs).
APP_URL=http://localhost:5173

# Idle session timeout, minutes.
SESSION_IDLE_MINUTES=30

# Number of reverse proxies in front of the app (1 behind Caddy/nginx) so rate limiting and the per-address login
# lockout see client IPs. Must be set explicitly when NODE_ENV=production.
TRUST_PROXY=0

# Encrypted file storage (outside the web root).
FILE_STORAGE_DIR=./storage
# 32 random bytes, hex (64 chars) or base64. REQUIRED (also in development — there is no built-in key outside the
# test suite). Generate: openssl rand -hex 32
# Also protects TOTP secrets at rest - losing it means every user must re-enrol 2FA.
FILE_ENCRYPTION_KEY=

# SMTP. REQUIRED when NODE_ENV=production. With SMTP_HOST empty (development) nothing is sent: only recipient and
# subject are logged, and the invitation / reset link is shown to the admin in the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bid Manager <no-reply@example.com>"

LOG_LEVEL=info

# Built web app to serve (default: ../web/dist when it exists; `off` = API only, e.g. when Vite serves the UI).
# WEB_DIST_DIR=
# Optional: URL that receives unhandled errors as JSON POSTs; label for the running version.
# ERROR_TRACKING_DSN=
# RELEASE=
# Two-role database setup (see ops/README.md): owner connection for `npm run migrate`, and the app role to grant.
# MIGRATION_DATABASE_URL=
# APP_DATABASE_ROLE=

# Used only by `npm run seed -w server`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
