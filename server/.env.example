# Copy to server/.env (loaded automatically outside of tests).
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://bidmanager:bidmanager@127.0.0.1:5432/bidmanager_dev

# Public URL of the web app (used in e-mail links and invitation URLs).
APP_URL=http://localhost:5173

# Idle session timeout, minutes.
SESSION_IDLE_MINUTES=30

# Set to the number of reverse proxies in front of the app (e.g. 1 behind nginx) so rate limiting sees client IPs.
TRUST_PROXY=0

# Encrypted file storage (outside the web root).
FILE_STORAGE_DIR=./storage
# 32 random bytes, hex (64 chars) or base64. REQUIRED in production. Generate: openssl rand -hex 32
# Also protects TOTP secrets at rest - losing it means every user must re-enrol 2FA.
FILE_ENCRYPTION_KEY=

# SMTP. Leave SMTP_HOST empty in development: mails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bid Manager <no-reply@example.com>"

LOG_LEVEL=info

# Used only by `npm run seed -w server`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
